  var n=W.length,g=n>1?(W[n-1][1]-W[n-2][1])/(W[n-1][0]-W[n-2][0]):-0.005;g=Math.min(-0.002,g);
  return Math.min(6000,W[n-1][0]+(CTW-W[n-1][1])/g);
