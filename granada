     st:[[0,[198,193,176]],[0.5,[200,222,240]],[3,[140,190,235]],[8,[70,140,220]],[15,[40,95,200]],[30,[60,50,165]],[60,[130,40,160]]]},
  c:{lo:0,hi:1,ticks:[],unit:'m',txt:''},
  s:{lo:0,hi:40,ticks:[0,5,10,20,30,40],unit:'cm',txt:'Nieve caída acumulada (estimada, sin fusión), cm.',
     st:[[0,[198,193,176]],[0.3,[214,222,232]],[2,[236,241,248]],[8,[250,252,255]],[20,[205,225,250]],[40,[150,190,240]]]}
};
function baseCol(z){return lerpStops([[0,[176,182,150]],[800,[196,188,160]],[1800,[188,178,160]],[3000,[205,200,196]]],z)}

/* ---------- escena ---------- */
var gl=null;
try{var c=document.createElement('canvas');gl=!!(window.WebGLRenderingContext&&(c.getContext('webgl')||c.getContext('experimental-webgl')))}catch(e){}
if(!window.THREE||!gl){stage.insertAdjacentHTML('beforeend','<div id="nogl">Este navegador no puede mostrar gráficos 3D (WebGL).</div>');return}
var renderer=new THREE.WebGLRenderer({antialias:true});
renderer.setPixelRatio(Math.min(2,window.devicePixelRatio||1));
stage.insertBefore(renderer.domElement,stage.firstChild);
var scene=new THREE.Scene();
function sceneBg(){try{renderer.setClearColor(new THREE.Color(getComputedStyle(stage).backgroundColor||'#dce6ec'),1)}catch(e){}}
sceneBg();try{window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change',function(){sceneBg();req()})}catch(e){}
var cam=new THREE.PerspectiveCamera(40,1,0.5,2000);
var ctr=new THREE.OrbitControls(cam,renderer.domElement);
ctr.enableDamping=true;ctr.dampingFactor=0.12;ctr.maxPolarAngle=Math.PI*0.47;ctr.minDistance=12;ctr.maxDistance=420;ctr.screenSpacePanning=false;
scene.add(new THREE.HemisphereLight(0xffffff,0x6a6a60,0.62));
var sun=new THREE.DirectionalLight(0xffffff,0.72);sun.position.set(-80,120,-60);scene.add(sun);

var pos=new Float32Array(NV*3),col=new Float32Array(NV*3);
function setHeights(){for(var q=0;q<NV;q++){pos[q*3]=wx(vLon[q]);pos[q*3+1]=vZ[q]/1000*EX;pos[q*3+2]=wz(vLat[q])}}
setHeights();
var geo=new THREE.BufferGeometry();
geo.setAttribute('position',new THREE.BufferAttribute(pos,3));
geo.setAttribute('color',new THREE.BufferAttribute(col,3));
geo.setIndex(tri);geo.computeVertexNormals();
var mesh=new THREE.Mesh(geo,new THREE.MeshLambertMaterial({vertexColors:true}));
scene.add(mesh);
/* contorno */
var outl=new THREE.Group();scene.add(outl);
function demAt(lat,lon){var i=Math.round((lon-DEM.lon0)/DEM.dlo),j=Math.round((lat-DEM.lat0)/DEM.dla);i=Math.max(0,Math.min(NX-1,i));j=Math.max(0,Math.min(NY-1,j));return Zm[j*NX+i]}
function buildOutline(){
  while(outl.children.length){var o=outl.children.pop();o.geometry.dispose()}
  DEM.outline.forEach(function(r){
    var pts=[];for(var i=0;i<r.length;i++){var a=r[i],b=r[(i+1)%r.length];for(var s=0;s<4;s++){var lo=a[0]+(b[0]-a[0])*s/4,la=a[1]+(b[1]-a[1])*s/4;pts.push(new THREE.Vector3(wx(lo),demAt(la,lo)/1000*EX+0.12,wz(la)))}}
    outl.add(new THREE.LineLoop(new THREE.BufferGeometry().setFromPoints(pts),new THREE.LineBasicMaterial({color:0x13222c,transparent:true,opacity:0.7})));
  });
}
buildOutline();

/* ---------- lugares ---------- */
var PLACES=[['Granada',37.1773,-3.5986],['Albolote',37.2306,-3.6567,1],['Motril',36.7458,-3.5179],['Almuñécar',36.7339,-3.6907,0,1],['Guadix',37.2994,-3.1386],['Baza',37.4902,-2.7733],
  ['Loja',37.1687,-4.1508],['Huéscar',37.8095,-2.5411],['Alhama de Granada',37.0067,-3.989,0,1],['Órgiva',36.8996,-3.4245,0,1],['Iznalloz',37.3925,-3.5258,0,1],['Montefrío',37.3218,-4.0094,0,1],
  ['Mulhacén',37.0533,-3.3114,2]];
var labBox=$('#labels'),labs=PLACES.map(function(p){var d=document.createElement('div');d.className='lab'+(p[3]===2?' peak':'')+(p[3]===1?' home':'');labBox.appendChild(d);
  var best=-1,bd=1e9;for(var q=0;q<NV;q++){var dd=Math.pow(vLat[q]-p[1],2)+Math.pow((vLon[q]-p[2])*0.8,2);if(dd<bd){bd=dd;best=q}}
  return {p:p,el:d,q:best}});

/* ---------- estado ---------- */
var LAY='t',cur=0,fieldCache={},timer=null;
try{var sv=JSON.parse(localStorage.getItem('g3d')||'{}');if(sv.lay&&PAL[sv.lay])LAY=sv.lay;if([1,2,3].indexOf(sv.ex)>=0)EX=sv.ex}catch(e){}
function save(){try{localStorage.setItem('g3d',JSON.stringify({lay:LAY,ex:EX}))}catch(e){}}
var nowMs=Date.now();for(var f0=0;f0<NF;f0++) if(new Date(MET.t[f0]).getTime()>=nowMs-90*60000){cur=f0;break}
function values(f){
  var k=LAY+f;if(fieldCache[k]) return fieldCache[k];
  var v=LAY==='t'?tempField(f).T:LAY==='r'?rainField(f):LAY==='c'?cotaField(f):snowCum[f];
  var ks=Object.keys(fieldCache);if(ks.length>12) delete fieldCache[ks[0]];
  return fieldCache[k]=v;
}
function cotaField(f){var N=nodes(f),C=new Float32Array(NV);for(var q=0;q<NV;q++){var s=0;for(var m=0;m<4;m++)s+=vW[q*4+m]*N[vN[q*4+m]].cota;C[q]=s}return C}
function prField(f){var R=new Float32Array(NV),pr=S.pr[f];for(var q=0;q<NV;q++){var s=0;for(var m=0;m<4;m++)s+=vW[q*4+m]*pr[vN[q*4+m]]/10;R[q]=s}return R}
function fmtM(v){return v>=4000?'> 4000 m':(Math.round(v/100)*100).toLocaleString('es-ES')+' m'}
function fmtV(v){if(LAY==='c')return fmtM(v);return LAY==='t'?Math.round(v)+'°':LAY==='r'?(v<0.5?'0 mm':v<10?v.toFixed(1).replace('.',',')+' mm':Math.round(v)+' mm'):(v<0.5?'0 cm':Math.round(v)+' cm')}
function paint(){
  var v=values(cur),pl=PAL[LAY];
  if(LAY==='c'){
    var pr=prField(cur),SNP=[246,249,255],SND=[196,212,232],LN=[38,92,176];
    for(var q=0;q<NV;q++){
      var z=vZ[q],ct=v[q],c=baseCol(z),d=z-ct;
      if(d>=0){var tgt=pr[q]>=0.1?SNP:SND,t=Math.min(1,d/120+0.35);c=[c[0]+(tgt[0]-c[0])*t,c[1]+(tgt[1]-c[1])*t,c[2]+(tgt[2]-c[2])*t]}
      if(Math.abs(d)<35*Math.max(1,ct/1500)) c=LN;
      col[q*3]=c[0]/255;col[q*3+1]=c[1]/255;col[q*3+2]=c[2]/255;
    }
    geo.attributes.color.needsUpdate=true;
    labs.forEach(function(l){l.el.innerHTML=(l.p[3]===2?'▲ ':'')+l.p[0]+' <b>'+fmtM(v[l.q])+'</b>'});
    cotaInfo(v,pr);
    $('#tlbl').textContent=tl(cur);$('#tcnt').textContent=(cur+1)+' de '+NF;$('#trange').value=cur;$('#probe').hidden=true;req();return;
  }
  for(var q=0;q<NV;q++){
    var c=LAY==='t'?lerpStops(pl.st,v[q]):(v[q]<0.05?baseCol(vZ[q]):lerpStops(pl.st,v[q]));
    if(LAY!=='t'&&v[q]>=0.05&&v[q]<0.6){var b=baseCol(vZ[q]),t=v[q]/0.6;c=[b[0]+(c[0]-b[0])*t,b[1]+(c[1]-b[1])*t,b[2]+(c[2]-b[2])*t]}
    col[q*3]=c[0]/255;col[q*3+1]=c[1]/255;col[q*3+2]=c[2]/255;
  }
  geo.attributes.color.needsUpdate=true;
  labs.forEach(function(l){l.el.innerHTML=(l.p[3]===2?'▲ ':'')+l.p[0]+' <b>'+fmtV(v[l.q])+'</b>'});
  $('#tlbl').textContent=tl(cur);$('#tcnt').textContent=(cur+1)+' de '+NF;$('#trange').value=cur;
  $('#probe').hidden=true;
  req();
}
function cotaInfo(v,pr){
  var e=$('#cinfo');if(!e) return;
  var lo=1e9,hi=-1e9,wet=0;for(var q=0;q<NV;q++){if(v[q]<lo)lo=v[q];if(v[q]>hi)hi=v[q];if(pr[q]>=0.1)wet++}
  e.textContent='En este momento la cota va de '+fmtM(lo)+' a '+fmtM(hi)+' según la zona. '+(wet>NV*0.02?'Está precipitando en parte de la provincia (blanco intenso).':'Ahora no precipita en casi ninguna zona: la cota indica dónde nevaría si lo hiciera.');
}
function legend(){
  if(LAY==='c'){
    $('#legend').innerHTML='<div class="crow"><span class="sw" style="background:rgb(246,249,255)"></span>Por encima de la cota, precipitando'+
      '<span class="sw" style="background:rgb(196,212,232)"></span>Por encima de la cota, sin precipitar<span class="sw ln" style="background:rgb(38,92,176)"></span>Cota de nieve</div>'+
      '<div class="lt" id="cinfo"></div><div class="lt">Altitud a partir de la cual la precipitación cae sobre todo como nieve (bulbo húmedo ≈ 0,75 °C), calculada con el perfil del modelo; redondeada a 100 m.</div>';
    return;
  }
  var pl=PAL[LAY],span=pl.hi-pl.lo,g=[];
  for(var i=0;i<=40;i++){var v=pl.lo+span*i/40,c=lerpStops(pl.st,v);g.push('rgb('+c.map(Math.round).join(',')+') '+(i*2.5)+'%')}
  $('#legend').innerHTML='<div class="lbar" style="background:linear-gradient(90deg,'+g.join(',')+')"></div><div class="ltk">'+
    pl.ticks.map(function(t){return '<span style="left:'+((t-pl.lo)/span*100)+'%">'+t+'</span>'}).join('')+'</div><div class="lt">'+pl.txt+'</div>';
}
function setLayer(k){
  if(k==='s'&&!snowCum){var bz=$('#busy');bz.textContent='Calculando la nieve…';bz.hidden=false;setTimeout(function(){buildSnow();bz.hidden=true;setLayer(k)},30);return}
  LAY=k;save();
  document.querySelectorAll('[data-lay]').forEach(function(b){b.setAttribute('aria-pressed',b.getAttribute('data-lay')===k?'true':'false')});
  legend();paint();
}
function setEx(e){
  EX=e;save();setHeights();geo.attributes.position.needsUpdate=true;geo.computeVertexNormals();buildOutline();
  document.querySelectorAll('[data-ex]').forEach(function(b){b.setAttribute('aria-pressed',+b.getAttribute('data-ex')===e?'true':'false')});
  $('#probe').hidden=true;req();
}

/* ---------- cámara y render bajo demanda ---------- */
function home(){var a=stage.clientWidth/Math.max(1,stage.clientHeight),k=a<1.45?Math.min(1.7,1.2/a):1;ctr.target.set(0,0,4);cam.position.set(-20*k,150*k,175*k);ctr.update();req()}
var raf=0;function req(){if(!raf) raf=requestAnimationFrame(frame)}
var v3=new THREE.Vector3();
function frame(){
  raf=0;var moving=ctr.update();
  renderer.render(scene,cam);
  var W=stage.clientWidth,Hh=stage.clientHeight;
  var small=W<640;
  labs.forEach(function(l){if(small&&l.p[4]){l.el.style.display='none';return}var q=l.q;v3.set(pos[q*3],pos[q*3+1]+0.15,pos[q*3+2]).project(cam);
    if(v3.z>1||v3.x<-1.05||v3.x>1.05||v3.y<-1.05||v3.y>1.05){l.el.style.display='none';return}
    l.el.style.display='';l.el.style.left=((v3.x+1)/2*W)+'px';l.el.style.top=((1-v3.y)/2*Hh)+'px'});
  if(pv){v3.copy(pv).project(cam);var pr=$('#probe');pr.style.left=((v3.x+1)/2*W)+'px';pr.style.top=((1-v3.y)/2*Hh)+'px'}
  if(moving) req();
}
ctr.addEventListener('change',req);
function resize(){var w=stage.clientWidth,h=stage.clientHeight;renderer.setSize(w,h,false);cam.aspect=w/h;cam.updateProjectionMatrix();req()}
window.addEventListener('resize',resize);
try{new ResizeObserver(resize).observe(stage)}catch(e){}

/* ---------- sonda al tocar ---------- */
var ray=new THREE.Raycaster(),down=null,pv=null;
renderer.domElement.addEventListener('pointerdown',function(e){down=[e.clientX,e.clientY]});
renderer.domElement.addEventListener('pointerup',function(e){
  if(!down||Math.abs(e.clientX-down[0])+Math.abs(e.clientY-down[1])>6){down=null;return}down=null;
  var r=renderer.domElement.getBoundingClientRect();
  ray.setFromCamera({x:(e.clientX-r.left)/r.width*2-1,y:-(e.clientY-r.top)/r.height*2+1},cam);
  var hit=ray.intersectObject(mesh)[0],pr=$('#probe');
  if(!hit){pr.hidden=true;pv=null;req();return}
  var fc=hit.face,cand=[fc.a,fc.b,fc.c],best=cand[0],bd=1e9;
  cand.forEach(function(q){var dx=pos[q*3]-hit.point.x,dz=pos[q*3+2]-hit.point.z,d=dx*dx+dz*dz;if(d<bd){bd=d;best=q}});
  var v=values(cur)[best];
  pr.innerHTML=(LAY==='c'?'Cota '+fmtV(v):fmtV(v).replace('°',' °C'))+' · '+Math.round(vZ[best])+' m<br><span style="opacity:.75">'+vLat[best].toFixed(3).replace('.',',')+' N, '+Math.abs(vLon[best]).toFixed(3).replace('.',',')+' O</span>';
  pr.hidden=false;pv=new THREE.Vector3(pos[best*3],pos[best*3+1],pos[best*3+2]);req();
});

/* ---------- controles ---------- */
document.querySelectorAll('[data-lay]').forEach(function(b){b.addEventListener('click',function(){setLayer(b.getAttribute('data-lay'))})});
document.querySelectorAll('[data-ex]').forEach(function(b){b.addEventListener('click',function(){setEx(+b.getAttribute('data-ex'))})});
$('#reset').addEventListener('click',home);
var rng=$('#trange');rng.max=NF-1;rng.addEventListener('input',function(){stop();cur=+rng.value;paint()});
$('#t0').textContent=tl(0);$('#t1').textContent=tl(NF-1);
function stop(){if(timer){clearInterval(timer);timer=null}$('#play').textContent='Reproducir'}
$('#play').addEventListener('click',function(){if(timer){stop();return}$('#play').textContent='Pausa';timer=setInterval(function(){cur=(cur+1)%NF;paint()},900)});
$('#foot').textContent='Modelo ECMWF IFS (9 km y 0,25°), datos de Open-Meteo (CC BY 4.0), pasada del '+MET.run+'. Relieve: Copernicus DEM GLO-90, © DLR e.V. 2010-2014 y © Airbus Defence and Space GmbH 2014-2018, proporcionado bajo COPERNICUS por la Unión Europea y la ESA. Límite provincial: es-atlas (IGN). Horas de España.';

resize();home();
if(EX!==2) setEx(EX); else document.querySelectorAll('[data-ex]').forEach(function(b){b.setAttribute('aria-pressed',+b.getAttribute('data-ex')===EX?'true':'false')});
setLayer(LAY);
})();
</script>
