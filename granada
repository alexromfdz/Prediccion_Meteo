  for(var i=1;i<n;i++) if(z<=W[i][0]){var t=(z-W[i-1][0])/(W[i][0]-W[i-1][0]);return W[i-1][1]+(W[i][1]-W[i-1][1])*t}
  var g=n>1?(W[n-1][1]-W[n-2][1])/(W[n-1][0]-W[n-2][0]):-0.005;return W[n-1][1]+Math.min(-0.002,g)*(z-W[n-1][0]);
